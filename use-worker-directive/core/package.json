{
  "name": "use-worker-directive",
  "version": "0.6.1",
  "description": "Universal \"use worker\" functions",
  "keywords": [
    "directive",
    "seroval",
    "use-worker",
    "web-worker"
  ],
  "homepage": "https://github.com/lxsmnsyc/dismantle/tree/main/use-worker-directive/core",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/dismantle/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/dismantle.git",
    "directory": "use-worker-directive/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "compiler": [
        "./dist/compiler.d.ts"
      ],
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "setup": [
        "./dist/setup.d.ts"
      ]
    }
  },
  "exports": {
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "require": "./dist/compiler.cjs"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./setup": {
      "import": "./dist/setup.js",
      "require": "./dist/setup.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "dismantle": "workspace:^",
    "seroval": "^1.4.2",
    "seroval-plugins": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
