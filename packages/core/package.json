{
  "name": "dismantle",
  "version": "0.6.1",
  "description": "Universal semi-automatic code-splitter",
  "keywords": [
    "babel",
    "code-splitting",
    "directive",
    "use-server"
  ],
  "homepage": "https://github.com/lxsmnsyc/dismantle/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/dismantle/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/dismantle.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@babel/generator": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
