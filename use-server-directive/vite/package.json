{
  "name": "vite-plugin-use-server-directive",
  "version": "0.6.1",
  "description": "Vite plugin for use-server-directive",
  "keywords": [
    "use-server",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/lxsmnsyc/dismantle/tree/main/use-server-directive/vite",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/dismantle/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/dismantle.git",
    "directory": "use-server-directive/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "use-server-directive": "workspace:^",
    "vite": "^6.2.1"
  },
  "peerDependencies": {
    "use-server-directive": "workspace:^",
    "vite": ">=4"
  },
  "engines": {
    "node": ">=20"
  }
}
